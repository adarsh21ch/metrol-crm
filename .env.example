# Copy to .env and fill in from Supabase → Project Settings → API.
# Both of these are safe in a browser bundle: the anon key is protected by the
# row level security policies in supabase/migrations/0001_init.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The service role key bypasses RLS entirely. It must never appear in this app,
# in the browser, or in the repo — server side only, if ever.
